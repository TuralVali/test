import pandas as pd
import plotly.express as px

# ----------------------------
# 1. Create example DataFrame
# ----------------------------
dates = pd.date_range(start="2024-01-01", periods=60, freq="D")

scenario_a = [
    2, 3, 1, 0, -1, 1, 2, 3, 4, 3,
    2, 1, 0, -1, -2, 0, 1, 2, 3, 4,
    5, 6, 5, 4, 3, 2, 1, 0, -1, 0,
    1, 2, 3, 4, 5, 6, 7, 6, 5, 4,
    3, 2, 1, 0, -1, -2, -1, 0, 1, 2,
    3, 4, 5, 6, 7, 8, 7, 6, 5, 4
]

scenario_b = [v + 1 for v in scenario_a]
scenario_c = [v - 1 for v in scenario_a]

df = pd.DataFrame({
    "Formatted Date": list(dates) * 3,
    "Scenario": ["Scenario A"] * 60 + ["Scenario B"] * 60 + ["Scenario C"] * 60,
    "Temperature (C)": scenario_a + scenario_b + scenario_c
})

# ----------------------------
# 2. Plotly line chart
# ----------------------------
fig = px.line(
    df,
    x="Formatted Date",
    y="Temperature (C)",
    color="Scenario",
    title="Interactive charts with X Slider + Y Controls"
)

# ----------------------------
# 3. Layout & Controls
# ----------------------------
fig.update_layout(
    plot_bgcolor="white",
    paper_bgcolor="white",

    # X AXIS (true range slider)
    xaxis=dict(
        rangeselector=dict(
            buttons=[
                dict(count=7, label="1W", step="day", stepmode="backward"),
                dict(count=14, label="2W", step="day", stepmode="backward"),
                dict(count=1, label="1M", step="month", stepmode="backward"),
                dict(step="all")
            ]
        ),
        rangeslider=dict(visible=True),
        type="date",
        showgrid=True,
        gridcolor="lightgray"
    ),

    # Y AXIS (interactive zoom enabled)
    yaxis=dict(
        title="Temperature (C)",
        showgrid=True,
        gridcolor="lightgray",
        fixedrange=False
    ),

    # Y-AXIS RANGE BUTTONS (slider alternative)
    updatemenus=[
        dict(
            type="buttons",
            direction="right",
            x=0.5,
            y=1.18,
            xanchor="center",
            buttons=[
                dict(
                    label="Auto Y",
                    method="relayout",
                    args=[{"yaxis.autorange": True}]
                ),
                dict(
                    label="Tight Y",
                    method="relayout",
                    args=[{"yaxis.range": [-2, 6]}]
                ),
                dict(
                    label="Wide Y",
                    method="relayout",
                    args=[{"yaxis.range": [-5, 10]}]
                )
            ]
        )
    ],

    # Legend below chart
    legend=dict(
        orientation="h",
        yanchor="top",
        y=-0.12,
        xanchor="center",
        x=0.5
    ),

    margin=dict(t=120, b=120)
)

fig.show()

