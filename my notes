import pandas as pd
import numpy as np
import plotly.express as px

# ----------------------------
# Sample data
# ----------------------------
dates = pd.date_range("2024-01-01", periods=30, freq="D")
df = pd.DataFrame({
    "date": dates,
    "value": np.cumsum(np.random.randn(30)),
    "series": "A"
}).sort_values("date")

cutoff_date = pd.to_datetime("2024-01-15")

# Solid part includes cutoff
df_before = df[df["date"] <= cutoff_date].copy()

# Dashed part starts after cutoff...
df_after = df[df["date"] > cutoff_date].copy()

# ...but prepend the last "before" point to CONNECT the line
if not df_before.empty:
    last_point = df_before.iloc[[-1]]
    df_after = pd.concat([last_point, df_after], ignore_index=True)

# Base figure (solid)
fig = px.line(df_before, x="date", y="value", color="series",
              title="Continuous line: solid before cutoff, dashed after")

# Add dashed continuation
if not df_after.empty:
    fig_after = px.line(df_after, x="date", y="value", color="series")
    for tr in fig_after.data:
        tr.line.dash = "dash"
        fig.add_trace(tr)

# Cutoff vertical line (compatible with older Plotly)
fig.add_shape(
    type="line",
    x0=cutoff_date, x1=cutoff_date,
    y0=0, y1=1,
    xref="x", yref="paper",
    line=dict(width=2, dash="dot")
)

fig.add_annotation(
    x=cutoff_date, y=1,
    xref="x", yref="paper",
    text=f"Cutoff: {cutoff_date.date()}",
    showarrow=False,
    yanchor="bottom"
)

fig.update_layout(template="plotly_white")
fig.show()


