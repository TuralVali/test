logger = logging.getLogger(__name__)
stream_handler = logging.StreamHandler() # message to output, to console
formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
stream_handler.setFormatter(formatter)    
logger.addHandler(stream_handler)           
stream_handler.setLevel(logging.WARNING) #warning and above, i.e. +error and critical
file_handler = logging.FileHandler("mylog.log")
stream_handler.setLevel(logging.CRITICAL) #critical 
logger.addHandler(file_handler)   


logger.info("This message will not be processed by the handler")
logger.warning("This message will be processed by the handler")

