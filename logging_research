# Next, we should understand the concept of log levels. Every logger instance can be assigned a log level. Python knows 5 levels:

# DEBUG - by default not going to console
# INFO - by default not going to console
# WARNING
# ERROR
# CRITICAL

logging.debug("no print") #10
logging.info("no print") #20
logging.warning("printed") #30
logging.error("printed") #40
logging.critical("printed") #50
