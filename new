import customtkinter as ctk
from tkinter import messagebox
from datetime import date

# ============================================================
# THEME PALETTES
# ============================================================
THEMES = {
    "dark": {
        "APP_BG": "#0E1117",
        "HEADER_BG": "#141824",
        "HEADER_TEXT": "#E6EAF2",
        "RED_LINE": "#D11A2A",

        "PANEL_BG": "#161B22",
        "CARD_BG": "#1C2230",
        "INPUT_BG": "#0F1420",

        "TEXT_MAIN": "#E6EAF2",
        "TEXT_MUTED": "#9AA4B2",

        "PRIMARY": "#1F6FEB",
        "PRIMARY_HOVER": "#1158C7",

        "BTN_GREEN": "#238636",
        "BTN_GREEN_HOV": "#2EA043",

        "BTN_YELLOW": "#D29922",
        "BTN_YELLOW_HOV": "#B88719",

        "BTN_GRAY": "#2A3142",
        "BTN_GRAY_HOV": "#3A4257",

        "STATUS_OK": "#3FB950",
        "STATUS_ERR": "#F85149",
    },

    "light": {
        "APP_BG": "#F3F5F8",
        "HEADER_BG": "#0B3A78",
        "HEADER_TEXT": "#FFFFFF",
        "RED_LINE": "#D11A2A",

        "PANEL_BG": "#F3F5F8",
        "CARD_BG": "#FFFFFF",
        "INPUT_BG": "#FFFFFF",

        "TEXT_MAIN": "#101828",
        "TEXT_MUTED": "#475467",

        # IMPORTANT: primary blue reused
        "PRIMARY": "#1F6FEB",
        "PRIMARY_HOVER": "#1158C7",

        "BTN_GREEN": "#1FA43A",
        "BTN_GREEN_HOV": "#17802C",

        "BTN_YELLOW": "#F0C200",
        "BTN_YELLOW_HOV": "#C9A300",

        "BTN_GRAY": "#E4E7EC",
        "BTN_GRAY_HOV": "#D0D5DD",

        "STATUS_OK": "#1FA43A",
        "STATUS_ERR": "#D11A2A",
    }
}

ctk.set_default_color_theme("dark-blue")


class ScenarioChartGenerator(ctk.CTk):
    def __init__(self):
        super().__init__()

        self.title("Scenario Chart Generator")
        self.geometry("980x640")
        self.minsize(900, 560)

        self.current_theme = "dark"
        ctk.set_appearance_mode("dark")

        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(1, weight=1)

        # ===== Header =====
        self.header = ctk.CTkFrame(self, corner_radius=0)
        self.header.grid(row=0, column=0, sticky="ew")
        self.header.grid_columnconfigure(0, weight=1)

        self.title_label = ctk.CTkLabel(
            self.header,
            text="Scenario Chart Generator",
            font=("Segoe UI", 28, "bold"),
        )
        self.title_label.grid(row=0, column=0, padx=22, pady=(16, 12), sticky="w")

        # Theme switch (same colors for both themes)
        self.theme_switch = ctk.CTkSegmentedButton(
            self.header,
            values=["Dark", "Light"],
            command=self.on_theme_change,
            height=34
        )
        self.theme_switch.set("Dark")
        self.theme_switch.grid(row=0, column=1, padx=22, pady=(16, 12))

        self.red_line = ctk.CTkFrame(self, height=2, corner_radius=0)
        self.red_line.grid(row=0, column=0, sticky="ew", pady=(72, 0))

        # ===== Panel =====
        self.panel = ctk.CTkFrame(self, corner_radius=0)
        self.panel.grid(row=1, column=0, sticky="nsew", padx=16, pady=16)

        self.card = ctk.CTkFrame(self.panel, corner_radius=16)
        self.card.pack(fill="both", expand=True)
        self.card.grid_columnconfigure(1, weight=1)
        self.card.grid_rowconfigure(8, weight=1)

        label_font = ("Segoe UI", 14)
        entry_font = ("Segoe UI", 13)

        self.var_type = ctk.StringVar(value="global")
        self.var_entity = ctk.StringVar()
        self.var_base_id = ctk.StringVar()
        self.var_stress_id = ctk.StringVar()
        self.var_mev_path = ctk.StringVar()
        self.var_pdf_path = ctk.StringVar(value="scenario_charts.pdf")
        self.var_start_date = ctk.StringVar(value=str(date.today()))

        self.labels, self.entries = [], []

        def add_row(r, text, widget):
            lbl = ctk.CTkLabel(self.card, text=text, font=label_font)
            lbl.grid(row=r, column=0, padx=(22, 14), pady=10, sticky="w")
            self.labels.append(lbl)
            widget.grid(row=r, column=1, padx=(0, 22), pady=10, sticky="ew")

        def entry(var):
            e = ctk.CTkEntry(self.card, textvariable=var, font=entry_font, height=38)
            self.entries.append(e)
            return e

        self.type_menu = ctk.CTkOptionMenu(
            self.card, variable=self.var_type,
            values=["global", "regional", "entity", "custom"],
            font=entry_font, height=38
        )
        add_row(0, "Type", self.type_menu)
        add_row(1, "Entity", entry(self.var_entity))
        add_row(2, "Base Scenario ID", entry(self.var_base_id))
        add_row(3, "Stress Scenario ID", entry(self.var_stress_id))
        add_row(4, "MEVs file path", entry(self.var_mev_path))
        add_row(5, "PDF Output Path", entry(self.var_pdf_path))
        add_row(6, "Forecast Start Date", entry(self.var_start_date))

        # ===== Buttons =====
        btn_row = ctk.CTkFrame(self.card, fg_color="transparent")
        btn_row.grid(row=7, column=0, columnspan=2, padx=22, pady=(16, 8), sticky="ew")
        btn_row.grid_columnconfigure((0, 1, 2, 3), weight=1)

        self.btn_fill = ctk.CTkButton(btn_row, text="Fill Example", height=46, command=self.fill_example)
        self.btn_clear = ctk.CTkButton(btn_row, text="Clear All", height=46, command=self.clear_all)
        self.btn_generate = ctk.CTkButton(btn_row, text="Generate Charts", height=46, command=self.generate_charts)
        self.btn_quit = ctk.CTkButton(btn_row, text="Quit", height=46, command=self.destroy)

        for i, b in enumerate([self.btn_fill, self.btn_clear, self.btn_generate, self.btn_quit]):
            b.grid(row=0, column=i, padx=8, sticky="ew")

        # ===== Status =====
        self.status_row = ctk.CTkFrame(self.card, fg_color="transparent")
        self.status_row.grid(row=9, column=0, columnspan=2, padx=22, pady=(8, 18), sticky="w")

        self.status_dot = ctk.CTkLabel(self.status_row, text="•", font=("Segoe UI", 22))
        self.status_label = ctk.CTkLabel(self.status_row, text="Ready", font=("Segoe UI", 13))
        self.status_dot.grid(row=0, column=0)
        self.status_label.grid(row=0, column=1, padx=(6, 0))

        self.apply_theme("dark")
        self.set_status("Ready", True)

    # ================= Theme =================
    def on_theme_change(self, value):
        theme = "dark" if value == "Dark" else "light"
        self.current_theme = theme
        ctk.set_appearance_mode(theme)
        self.apply_theme(theme)

    def apply_theme(self, theme):
        C = THEMES[theme]

        self.configure(fg_color=C["APP_BG"])
        self.header.configure(fg_color=C["HEADER_BG"])
        self.panel.configure(fg_color=C["PANEL_BG"])
        self.card.configure(fg_color=C["CARD_BG"])
        self.red_line.configure(fg_color=C["RED_LINE"])
        self.title_label.configure(text_color=C["HEADER_TEXT"])

        # SAME segmented button colors in both themes
        self.theme_switch.configure(
            fg_color=C["BTN_GRAY"],
            selected_color=C["PRIMARY"],
            selected_hover_color=C["PRIMARY_HOVER"],
            unselected_color=C["BTN_GRAY"],
            unselected_hover_color=C["BTN_GRAY_HOV"],
            text_color=C["TEXT_MAIN"]
        )

        for lbl in self.labels:
            lbl.configure(text_color=C["TEXT_MAIN"])

        for e in self.entries:
            e.configure(
                fg_color=C["INPUT_BG"],
                text_color=C["TEXT_MAIN"],
                border_color=C["PRIMARY"],   # dark blue border
                placeholder_text_color=C["TEXT_MUTED"]
            )

        self.type_menu.configure(
            fg_color=C["INPUT_BG"],
            text_color=C["TEXT_MAIN"],
            button_color=C["BTN_GRAY"],
            button_hover_color=C["BTN_GRAY_HOV"],
            dropdown_fg_color=C["INPUT_BG"],
            dropdown_text_color=C["TEXT_MAIN"]
        )

        # Buttons: DO NOT change text colors
        self.btn_fill.configure(fg_color=C["BTN_GREEN"], hover_color=C["BTN_GREEN_HOV"])
        self.btn_clear.configure(fg_color=C["BTN_YELLOW"], hover_color=C["BTN_YELLOW_HOV"])
        self.btn_generate.configure(fg_color=C["PRIMARY"], hover_color=C["PRIMARY_HOVER"])
        self.btn_quit.configure(fg_color=C["BTN_GRAY"], hover_color=C["BTN_GRAY_HOV"])

        self.status_label.configure(text_color=C["TEXT_MAIN"])
        self.status_dot.configure(text_color=C["STATUS_OK"])

    # ================= Logic =================
    def set_status(self, text, ok=True):
        C = THEMES[self.current_theme]
        self.status_label.configure(text=text)
        self.status_dot.configure(text_color=C["STATUS_OK"] if ok else C["STATUS_ERR"])

    def fill_example(self):
        self.var_entity.set("CITI_PL")
        self.var_base_id.set("BASE_2025Q4")
        self.var_stress_id.set("STRESS_2025Q4")
        self.var_mev_path.set(r"C:\data\mevs\mevs_2025q4.csv")
        self.var_start_date.set("2025-09-30")
        self.set_status("Example filled", True)

    def clear_all(self):
        for v in [self.var_entity, self.var_base_id, self.var_stress_id, self.var_mev_path]:
            v.set("")
        self.set_status("Cleared", True)

    def generate_charts(self):
        self.set_status("Generate Charts clicked (demo)", True)
        messagebox.showinfo("Generate Charts", "Demo action triggered")


if __name__ == "__main__":
    ScenarioChartGenerator().mainloop()
